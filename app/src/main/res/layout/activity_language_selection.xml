<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Programming Language Selection"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="30dp"
        android:textAlignment="center" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select your favorite programming languages:"
        android:textSize="18sp"
        android:layout_marginBottom="20dp"
        android:textAlignment="center" />

    <!-- Programming Languages CheckBoxes -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="30dp"
        android:gravity="start">

        <CheckBox
            android:id="@+id/checkBoxJava"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Java"
            android:textSize="18sp"
            android:layout_marginBottom="10dp"
            android:padding="8dp" />

        <CheckBox
            android:id="@+id/checkBoxPython"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Python"
            android:textSize="18sp"
            android:layout_marginBottom="10dp"
            android:padding="8dp" />

        <CheckBox
            android:id="@+id/checkBoxCpp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="C++"
            android:textSize="18sp"
            android:layout_marginBottom="10dp"
            android:padding="8dp" />

    </LinearLayout>

    <!-- Submit Button -->
    <Button
        android:id="@+id/buttonSubmit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Submit Selection"
        android:textSize="18sp"
        android:layout_marginBottom="20dp" />

    <!-- Clear Selection Button -->
    <Button
        android:id="@+id/buttonClear"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Clear All"
        android:textSize="16sp"
        android:backgroundTint="@android:color/holo_red_dark"
        android:layout_marginBottom="20dp" />

    <!-- Instructions -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select one or more programming languages and click Submit to see your selection."
        android:textSize="14sp"
        android:textAlignment="center"
        android:layout_marginTop="10dp"
        android:textColor="@android:color/darker_gray" />

</LinearLayout>