<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Student Registration Form"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp" />

    <!-- Name Field -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Name:"
        android:textSize="16sp"
        android:layout_gravity="start"
        android:layout_marginTop="10dp" />

    <EditText
        android:id="@+id/editTextName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter your name"
        android:inputType="textPersonName" />

    <!-- Email Field -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Email:"
        android:textSize="16sp"
        android:layout_gravity="start"
        android:layout_marginTop="10dp" />

    <EditText
        android:id="@+id/editTextEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter your email"
        android:inputType="textEmailAddress" />

    <!-- Phone Number Field -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Phone Number:"
        android:textSize="16sp"
        android:layout_gravity="start"
        android:layout_marginTop="10dp" />

    <EditText
        android:id="@+id/editTextPhone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter your phone number"
        android:inputType="phone" />

    <!-- Gender RadioButtons -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gender:"
        android:textSize="16sp"
        android:layout_gravity="start"
        android:layout_marginTop="15dp" />

    <RadioGroup
        android:id="@+id/radioGroupGender"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="5dp">

        <RadioButton
            android:id="@+id/radioMale"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Male"
            android:layout_marginEnd="20dp" />

        <RadioButton
            android:id="@+id/radioFemale"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Female" />

    </RadioGroup>

    <!-- Programming Languages CheckBoxes -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Programming Languages:"
        android:textSize="16sp"
        android:layout_gravity="start"
        android:layout_marginTop="15dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="5dp">

        <CheckBox
            android:id="@+id/checkBoxJava"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Java" />

        <CheckBox
            android:id="@+id/checkBoxPython"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Python" />

        <CheckBox
            android:id="@+id/checkBoxCpp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="C++" />

    </LinearLayout>

    <!-- Submit Button -->
    <Button
        android:id="@+id/buttonSubmit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Submit"
        android:layout_marginTop="20dp"
        android:textSize="18sp" />

    <!-- Navigation Button to Login -->
    <Button
        android:id="@+id/buttonGoToLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Go to Login Screen"
        android:layout_marginTop="10dp"
        android:textSize="16sp"
        android:backgroundTint="@android:color/holo_blue_dark" />

    <!-- Navigation Button to Profile -->
    <Button
        android:id="@+id/buttonGoToProfile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Go to Profile Screen"
        android:layout_marginTop="10dp"
        android:textSize="16sp"
        android:backgroundTint="@android:color/holo_green_dark" />

    <!-- Navigation Button to City Selection -->
    <Button
        android:id="@+id/buttonGoToCitySelection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Go to City Selection"
        android:layout_marginTop="10dp"
        android:textSize="16sp"
        android:backgroundTint="@android:color/holo_orange_dark" />

    <!-- Navigation Button to Language Selection -->
    <Button
        android:id="@+id/buttonGoToLanguageSelection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Go to Language Selection"
        android:layout_marginTop="10dp"
        android:textSize="16sp"
        android:backgroundTint="@android:color/holo_purple" />

    <!-- Navigation Button to Implicit Intent -->
    <Button
        android:id="@+id/buttonGoToImplicitIntent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Go to Implicit Intent Examples"
        android:layout_marginTop="10dp"
        android:textSize="16sp"
        android:backgroundTint="@android:color/darker_gray" />

    <!-- Navigation Button to Student Form -->
    <Button
        android:id="@+id/buttonGoToStudentForm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Go to Student Form"
        android:layout_marginTop="10dp"
        android:textSize="16sp"
        android:backgroundTint="@android:color/holo_purple" />

    <!-- Navigation Button to Hello Name App -->
    <Button
        android:id="@+id/buttonGoToHelloName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Go to Hello Name App"
        android:layout_marginTop="10dp"
        android:textSize="16sp"
        android:backgroundTint="@android:color/holo_blue_dark" />

    <!-- Navigation Button to Color Picker -->
    <Button
        android:id="@+id/buttonGoToColorPicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Go to Color Picker App"
        android:layout_marginTop="10dp"
        android:textSize="16sp"
        android:backgroundTint="@android:color/holo_red_dark" />

    <!-- Navigation Button to RadioButton Example -->
    <Button
        android:id="@+id/buttonGoToRadioButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Go to RadioButton Example"
        android:layout_marginTop="10dp"
        android:textSize="16sp"
        android:backgroundTint="@android:color/holo_blue_bright" />

    <!-- Navigation Button to CardView Example -->
    <Button
        android:id="@+id/buttonGoToCardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Go to CardView Example"
        android:layout_marginTop="10dp"
        android:textSize="16sp"
        android:backgroundTint="@android:color/holo_purple" />

    <!-- Navigation Button to Fragment Example -->
    <Button
        android:id="@+id/buttonGoToFragment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Go to Fragment Example"
        android:layout_marginTop="10dp"
        android:textSize="16sp"
        android:backgroundTint="@android:color/holo_blue_bright" />

    <!-- Navigation Button to Splash Screen -->
    <Button
        android:id="@+id/buttonGoToSplash"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Go to Splash Screen Demo"
        android:layout_marginTop="10dp"
        android:textSize="16sp"
        android:backgroundTint="@android:color/holo_green_dark" />

    <!-- Navigation Button to ListView -->
    <Button
        android:id="@+id/buttonGoToListView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Go to ListView with Adapter"
        android:layout_marginTop="10dp"
        android:textSize="16sp"
        android:backgroundTint="@android:color/holo_orange_dark" />

    <!-- Navigation Button to ViewPager -->
    <Button
        android:id="@+id/buttonGoToViewPager"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Go to ViewPager Example"
        android:layout_marginTop="10dp"
        android:textSize="16sp"
        android:backgroundTint="@android:color/holo_blue_dark" />

    <!-- Navigation Button to Context Menu -->
    <Button
        android:id="@+id/buttonGoToContextMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Go to Context Menu Example"
        android:layout_marginTop="10dp"
        android:textSize="16sp"
        android:backgroundTint="@android:color/holo_red_light" />

</LinearLayout>