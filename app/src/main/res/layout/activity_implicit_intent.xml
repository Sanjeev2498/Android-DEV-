<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Implicit Intent Examples"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="30dp"
        android:textAlignment="center" />

    <!-- Website Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Open Website:"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_gravity="start"
        android:layout_marginTop="10dp" />

    <EditText
        android:id="@+id/etWebsiteUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter website URL (e.g., www.google.com)"
        android:inputType="textUri"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnOpenWebsite"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Open Website"
        android:textSize="16sp"
        android:layout_marginBottom="25dp"
        android:backgroundTint="@android:color/holo_blue_dark" />

    <!-- Phone Call Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Make Phone Call:"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_gravity="start"
        android:layout_marginTop="10dp" />

    <EditText
        android:id="@+id/etPhoneNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter phone number"
        android:inputType="phone"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnMakeCall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Make Call"
        android:textSize="16sp"
        android:layout_marginBottom="25dp"
        android:backgroundTint="@android:color/holo_green_dark" />

    <!-- Maps Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Open Location in Maps:"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_gravity="start"
        android:layout_marginTop="10dp" />

    <EditText
        android:id="@+id/etLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter location (e.g., New Delhi, India)"
        android:inputType="text"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnOpenMaps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Open in Maps"
        android:textSize="16sp"
        android:layout_marginBottom="20dp"
        android:backgroundTint="@android:color/holo_orange_dark" />

    <!-- Instructions -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="• Website: Opens in default browser\n• Phone: Opens dialer with number\n• Maps: Opens location in maps app"
        android:textSize="14sp"
        android:textAlignment="center"
        android:layout_marginTop="10dp"
        android:textColor="@android:color/darker_gray" />

</LinearLayout>