<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="City Selection"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="30dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select your city:"
        android:textSize="18sp"
        android:layout_marginBottom="10dp" />

    <!-- City Spinner -->
    <Spinner
        android:id="@+id/spinnerCities"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:padding="10dp"
        android:background="@android:drawable/btn_dropdown" />

    <!-- Display Selected City Button -->
    <Button
        android:id="@+id/buttonShowCity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Show Selected City"
        android:textSize="18sp"
        android:layout_marginBottom="20dp" />

    <!-- Additional Info -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Choose a city from the dropdown above and click the button to see your selection."
        android:textSize="14sp"
        android:textAlignment="center"
        android:layout_marginTop="20dp"
        android:textColor="@android:color/darker_gray" />

</LinearLayout>