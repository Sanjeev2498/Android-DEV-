<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#FFFFFF"
    android:padding="16dp">

    <!-- App Logo -->
    <ImageView
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@mipmap/ic_launcher"
        android:scaleType="centerCrop"
        android:layout_marginBottom="20dp" />

    <!-- App Name -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SplashDemo"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#2E7D32"
        android:layout_marginBottom="10dp" />

    <!-- Welcome Message -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome to Main Screen"
        android:textSize="18sp"
        android:textColor="#4CAF50"
        android:layout_marginBottom="30dp" />

    <!-- Loading Indicator (Optional) -->
    <ProgressBar
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:layout_marginBottom="20dp" />

    <!-- Loading Text -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Loading..."
        android:textSize="16sp"
        android:textColor="#666666"
        android:layout_marginBottom="40dp" />

    <!-- Real World Use Info -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🌟 Real World Use\n• Used to show the app logo and create brand identity.\n• Gives time to load data, check login status, initialize libraries, etc.\n• Provides a smooth and professional user experience."
        android:textSize="12sp"
        android:textAlignment="center"
        android:textColor="#333333"
        android:background="#F5F5F5"
        android:padding="12dp"
        android:layout_marginTop="20dp" />

</LinearLayout>